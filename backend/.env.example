# Copy this file to .env and fill in the real values.
# .env is ignored by Git; never commit real secrets.

APP_NAME=SkinCare API
ENVIRONMENT=development

# PostgreSQL 16
DB_HOST=localhost
DB_PORT=5433
DB_NAME=skincare_app
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT (access tokens). Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=generate_a_long_random_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_REFRESH_TOKEN_EXPIRE_HOURS=12

# Browser origins allowed to call the API (JSON list). Empty = none; the mobile app needs none.
# Example for the React admin in development: CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGINS=[]

# Reject sign-up emails whose domain cannot receive email (DNS lookup, e.g. user@exasad.com)
EMAIL_CHECK_DELIVERABILITY=true

# Outgoing email: "console" prints emails in the server terminal (no account needed);
# "smtp" sends them through Gmail. SMTP_PASSWORD is a Gmail App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords), never your real password.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.app.address@gmail.com
SMTP_PASSWORD=
EMAIL_FROM_NAME=SkinCare App

# Google sign-in: the OAuth Client IDs that Google ID tokens must be issued for (JSON list:
# the Web client ID, later also the Android/iOS ones). Empty = Google sign-in refused.
GOOGLE_CLIENT_IDS=[]
