# Copy this file to .env and fill in the real values.
# .env is ignored by Git; never commit real secrets.

APP_NAME=SkinCare API
ENVIRONMENT=development

# PostgreSQL 16
DB_HOST=localhost
DB_PORT=5433
DB_NAME=skincare_app
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT (access tokens). Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=generate_a_long_random_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
